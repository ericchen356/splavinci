# Copy this file and fill in the value. .gitignore covers .env and .env.*, with
# this example file as the only exception, so the real key stays out of git.
#
#   cp .env.example .env.local
#   npx tsx --env-file=.env.local scripts/marble-generate.ts --help

# World Labs Marble API key. Required by scripts/marble-generate.ts for
# anything except --dry-run.
#
# Create one at https://platform.worldlabs.ai/api-keys. It is sent as the
# WLT-Api-Key header on every request to https://api.worldlabs.ai/marble/v1.
# Generation is billed in API credits, which are separate from Marble app
# credits: https://platform.worldlabs.ai/billing
WORLD_LABS_API_KEY=

# Optional. World Labs' own sample code reads WLT_API_KEY, so it is accepted as
# an alias — set either one, not both.
# WLT_API_KEY=

# Optional. Overrides the API base URL, for a proxy or a staging host.
# MARBLE_API_BASE_URL=https://api.worldlabs.ai/marble/v1
